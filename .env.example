PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/job_templete
BETTER_AUTH_SECRET=change-me-to-a-32-character-secret
BETTER_AUTH_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
# Workflow state uses the same PostgreSQL database by default.
WORKFLOW_TARGET_WORLD=@workflow/world-postgres
# Optional override; defaults to DATABASE_URL. Use a direct/session-mode URL for the worker.
WORKFLOW_POSTGRES_URL=
# Required to accept POST /api/webhooks/interview-reply (minimum 32 characters).
INTERVIEW_REPLY_WEBHOOK_SECRET=
MYDIGITALID_CLIENT_ID=
MYDIGITALID_CLIENT_SECRET=
